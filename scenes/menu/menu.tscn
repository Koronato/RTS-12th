[sub_resource type="GDScript" id="GDScript_4h3mk"]
script/source = "extends Control

#UI大小适配的 这将会很卡
func _enter_tree() -> void:
	self.size = get_viewport().get_visible_rect().size
	get_viewport().size_changed.connect(_on_viewport_size_changed)
func _on_viewport_size_changed() -> void:
	self.size = get_viewport().get_visible_rect().size
"

[sub_resource type="GDScript" id="GDScript_vjb58"]
script/source = "extends Control
#用于控制元件居中

@export var weight_size_x : float = 0.0
@export var interval_size : float = 1.0
@onready var normal_size : float = self.custom_minimum_size.x
var last_level : int = 0
var last_clicker : int = -1
var tween

func _ready() -> void:
	#判0
	if weight_size_x - 0.0 <= 1e-6:
		weight_size_x = $Menu.size.x
#不完整的实现,由于toggled信号自带一个bool参数,可以实现level的正负切换,因此level目前理论上不会超出-1--0
func _on_size_changed(level:int,clicker:int = -1,custom_size : int = 0) -> void:
	if tween and tween.is_running():
		tween.kill()
	tween = create_tween()
	tween.tween_property(self,\"custom_minimum_size:x\",normal_size + level * (interval_size + weight_size_x + custom_size),0.3)

	
	last_level = level
	last_clicker = clicker
"

