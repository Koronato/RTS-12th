[sub_resource type="Theme" id="Theme_yqeox"]

[sub_resource type="GDScript" id="GDScript_fajd5"]
script/source = "extends Control

#获取Button_group与目标Button
@export var Button_group : ButtonGroup
@export var aim_button : Button
#tween
var t
var num : int = 0 

func _ready() -> void:
	self.modulate.a = 0
	Button_group.pressed.connect(_on_button_pressed)
	aim_button.toggled.connect(_on_aim_button_pressed)

func _on_button_pressed(pressed_button:Button) -> void :
	if t and t.is_running():
		t.kill()
	t = create_tween()
	if pressed_button == aim_button:
		self.visible = true
		t.tween_property(self,\"modulate:a\",1,0.3)
	else:
		t.tween_property(self,\"modulate:a\",0,0.3)
		self.visible = false
	

#缩回时隐藏
func _on_aim_button_pressed(toggle:bool) -> void:
	if t and t.is_running():
		t.kill()
	t = create_tween()
	if !toggle:
		t.tween_property(self,\"modulate:a\",0,0.3)
		self.visible = false
	else:
		t.tween_property(self,\"modulate:a\",1,0.3)
"

[sub_resource type="GDScript" id="GDScript_sowkg"]
script/source = "extends Button


func _on_pressed() -> void:
	get_node(\"%Start\").visible = true
"

